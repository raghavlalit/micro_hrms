NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://microhrms_app:replace-runtime-password@127.0.0.1:5433/microhrms
MIGRATION_DATABASE_URL=postgresql://microhrms_migrator:replace-migration-password@127.0.0.1:5433/microhrms
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_ORIGINS=http://localhost:4200,http://localhost:3000
# Run npm.cmd run notifications:setup to configure local SMTP and generate a key.
# disabled keeps in-app alerts and records email as skipped; it never sends later.
EMAIL_DRIVER=disabled
WEB_ORIGIN=http://localhost:4200
REDIS_URL=redis://127.0.0.1:6380
# Separate background PDF/CSV worker: npm.cmd run jobs:worker
# BACKGROUND_QUEUE_PREFIX=microhrms
# API and generation worker must share these private storage paths.
# REPORT_EXPORT_STORAGE_DIR=/var/lib/microhrms/report-exports
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_FROM=Micro HRMS <no-reply@microhrms.test>
# SMTP_USER=
# SMTP_PASSWORD=
# Production requires HTTPS WEB_ORIGIN and authenticated/TLS SMTP as appropriate.
# Retain older keys until all queued invitations using them are finished/expired.
# NOTIFICATION_KEY_VERSION=v1
# NOTIFICATION_DATA_KEYS={"v1":"base64-encoded-32-byte-key"}
# Document storage defaults to private local storage in development.
# Production requires s3, a private bucket, and injected AWS role/secret credentials.
# DOCUMENT_STORAGE_DRIVER=local
# DOCUMENT_STORAGE_DIR=/var/lib/microhrms/documents
# DOCUMENT_S3_BUCKET=microhrms-uat-documents
# DOCUMENT_S3_REGION=ap-south-1
# DOCUMENT_S3_ENDPOINT=https://your-object-storage.example
# DOCUMENT_S3_FORCE_PATH_STYLE=true
# DOCUMENT_TENANT_QUOTA_BYTES=1073741824
# Private, persistent payslip storage; defaults to apps/api/storage/payslips locally.
# PAYSLIP_STORAGE_DIR=/var/lib/microhrms/payslips
# Required for non-ASCII names: readable TTF/OTF covering all used scripts.
# PAYSLIP_FONT_PATH=/opt/microhrms/fonts/company.ttf
# For production use DATABASE_SSL=true. Optionally supply your trusted CA PEM:
# DATABASE_SSL_CA=
# Required only for protected employee bank/statutory fields. Generate separate keys per environment.
# EMPLOYEE_DATA_KEY_VERSION=v1
# EMPLOYEE_DATA_KEYS='{"v1":"base64-encoded-32-byte-key"}'
