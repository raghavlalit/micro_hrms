NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://microhrms_app:replace-runtime-password@127.0.0.1:5433/microhrms
MIGRATION_DATABASE_URL=postgresql://microhrms_migrator:replace-migration-password@127.0.0.1:5433/microhrms
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_ORIGINS=http://localhost:4200,http://localhost:3000
# Private, persistent payslip storage; defaults to apps/api/storage/payslips locally.
# PAYSLIP_STORAGE_DIR=/var/lib/microhrms/payslips
# Required for non-ASCII names: readable TTF/OTF covering all used scripts.
# PAYSLIP_FONT_PATH=/opt/microhrms/fonts/company.ttf
# For production use DATABASE_SSL=true. Optionally supply your trusted CA PEM:
# DATABASE_SSL_CA=
# Required only for protected employee bank/statutory fields. Generate separate keys per environment.
# EMPLOYEE_DATA_KEY_VERSION=v1
# EMPLOYEE_DATA_KEYS='{"v1":"base64-encoded-32-byte-key"}'
